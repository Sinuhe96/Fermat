# Docker layer cache — rebuildable from Dockerfile, do not commit.
.buildcache/

# Scratch Lake test project — has its own nested .git and a 1.2GB .lake/.
# Kept on disk for reference only, never tracked here.
proof_verify/

# Large model binaries for the prover service — download separately.
*.gguf
*.safetensors
*.bin

# Lean/Lake build artifacts (applies now and when proof/ becomes a Lake project).
.lake/
lake-packages/
build/
*.olean
*.ilean
*.c
*.o

# Pipeline extraction outputs — reproducible from the PDF + extract.py.
# Keep the scripts and reports' schema, not the bulky regenerable text.
pipeline/01-extract/out/

# Author report package — regenerable from the queries + chunk records by
# 05-feedback/render_report.py (same policy as 01-extract/out/). Ship a copy
# with `render_report.py --zip`; never hand-edit it.
pipeline/05-feedback/report/
pipeline/05-feedback/report*.zip

# Personal tooling state (editor/agent config), not project content.
.commandcode/
.vscode/
.idea/

# Python bytecode caches.
__pycache__/

# OS noise.
Thumbs.db
Desktop.ini
.DS_Store
