@Polynomial.natDegree_mul : ∀ {R : Type u_1} [inst : Semiring R] [NoZeroDivisors R] {p q : Polynomial R},
  p ≠ 0 → q ≠ 0 → (p * q).natDegree = p.natDegree + q.natDegree
@Polynomial.natDegree_X_add_C : ∀ {R : Type u_1} [Nontrivial R] [inst : Semiring R] (x : R),
  (Polynomial.X + Polynomial.C x).natDegree = 1
@Polynomial.natDegree_map : ∀ {R : Type u_1} {S : Type u_2} [inst : Ring R] [IsSimpleRing R] [inst_2 : Semiring S]
  [Nontrivial S] {p : Polynomial R} (f : R →+* S), (Polynomial.map f p).natDegree = p.natDegree
@Polynomial.map_eq_zero : ∀ {R : Type u_1} {S : Type u_2} [inst : Ring R] [IsSimpleRing R] [inst_2 : Semiring S]
  [Nontrivial S] {p : Polynomial R} (f : R →+* S), Polynomial.map f p = 0 ↔ p = 0
@Polynomial.derivative_pow : ∀ {R : Type u_1} [inst : CommSemiring R] (p : Polynomial R) (n : ℕ),
  Polynomial.derivative (p ^ n) = Polynomial.C ↑n * p ^ (n - 1) * Polynomial.derivative p
@Polynomial.derivative_X_add_C : ∀ {R : Type u_1} [inst : Semiring R] (c : R),
  Polynomial.derivative (Polynomial.X + Polynomial.C c) = 1
@Polynomial.derivative_mul : ∀ {R : Type u_1} [inst : Semiring R] {f g : Polynomial R},
  Polynomial.derivative (f * g) = Polynomial.derivative f * g + f * Polynomial.derivative g
@Polynomial.derivative_sub : ∀ {R : Type u_1} [inst : Ring R] {f g : Polynomial R},
  Polynomial.derivative (f - g) = Polynomial.derivative f - Polynomial.derivative g
@Polynomial.derivative_X : ∀ {R : Type u_1} [inst : Semiring R], Polynomial.derivative Polynomial.X = 1
@Polynomial.derivative_C : ∀ {R : Type u_1} [inst : Semiring R] {a : R}, Polynomial.derivative (Polynomial.C a) = 0
@Polynomial.derivative_X_pow : ∀ {R : Type u_1} [inst : Semiring R] (n : ℕ),
  Polynomial.derivative (Polynomial.X ^ n) = Polynomial.C ↑n * Polynomial.X ^ (n - 1)
