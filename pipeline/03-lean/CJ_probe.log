@Polynomial.coeff_C_mul : ∀ {R : Type u_1} {a : R} {n : ℕ} [inst : Semiring R] (p : Polynomial R),
  (Polynomial.C a * p).coeff n = a * p.coeff n
@Polynomial.coeff_X_add_C_pow : ∀ {R : Type u_1} [inst : Semiring R] (r : R) (n k : ℕ),
  ((Polynomial.X + Polynomial.C r) ^ n).coeff k = r ^ (n - k) * ↑(n.choose k)
@Polynomial.coeff_X_pow : ∀ {R : Type u_1} [inst : Semiring R] (k n : ℕ),
  (Polynomial.X ^ k).coeff n = if n = k then 1 else 0
