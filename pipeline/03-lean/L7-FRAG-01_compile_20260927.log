    `L7_pair_reductio (X := -b) (Y := a) (Z := c)` and one final
    `rw [Odd.neg_pow hodd b]; ring` to read (−b)^n + a^n as a^n − b^n.
  * L7_step_S6   {n : ℕ} (hn : Nat.Prime n) {a b c : ℤ}
      (hd : ¬ (n : ℤ) ∣ a ^ n - b ^ n)
      (hbc : ¬ (n : ℤ) ∣ b ^ n + c ^ n)
      (hca : ¬ (n : ℤ) ∣ c ^ n + a ^ n) :
      ¬ (n : ℤ) ∣ (a ^ n - b ^ n) * (c ^ n + a ^ n) * (c ^ n + b ^ n)
