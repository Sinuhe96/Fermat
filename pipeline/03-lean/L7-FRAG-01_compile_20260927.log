      (hb : ¬ (n : ℤ) ∣ b)
      (h1n : (c : ZMod n) ^ n = (a : ZMod n) ^ n + (b : ZMod n) ^ n)
      (h2n : (c : ZMod n) ^ (n * (n - 2))
        = (a : ZMod n) ^ (n * (n - 2)) + (b : ZMod n) ^ (n * (n - 2))) :
      ¬ (n : ℤ) ∣ a ^ n - b ^ n
    body: (b)/(c) rearranged to a^n ≡ c^n + (−b)^n and a^e ≡ c^e + (−b)^e
