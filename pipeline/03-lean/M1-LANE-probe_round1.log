Nat.choose_self : ∀ (n : ℕ), n.choose n = 1
@Nat.choose_eq_zero_of_lt : ∀ {n k : ℕ}, n < k → n.choose k = 0
@Nat.choose_mul : ∀ {n k s : ℕ}, s ≤ k → n.choose k * k.choose s = n.choose s * (n - s).choose (k - s)
Nat.choose_mul_succ_eq : ∀ (n k : ℕ), n.choose k * (n + 1) = (n + 1).choose k * (n + 1 - k)
Nat.cast_choose : ∀ (K : Type u_1) [inst : DivisionSemiring K] [CharZero K] {a b : ℕ},
  a ≤ b → ↑(b.choose a) = ↑b.factorial / (↑a.factorial * ↑(b - a).factorial)
@Finset.sum_range_succ : ∀ {M : Type u_1} [inst : AddCommMonoid M] (f : ℕ → M) (n : ℕ),
  ∑ x ∈ Finset.range (n + 1), f x = ∑ x ∈ Finset.range n, f x + f n
@Finset.sum_range_succ' : ∀ {M : Type u_1} [inst : AddCommMonoid M] (f : ℕ → M) (n : ℕ),
  ∑ k ∈ Finset.range (n + 1), f k = ∑ k ∈ Finset.range n, f (k + 1) + f 0
@Finset.sum_range_sub : ∀ {G : Type u_1} [inst : AddCommGroup G] (f : ℕ → G) (n : ℕ),
  ∑ i ∈ Finset.range n, (f (i + 1) - f i) = f n - f 0
@Finset.sum_range_sub' : ∀ {G : Type u_1} [inst : AddCommGroup G] (f : ℕ → G) (n : ℕ),
  ∑ i ∈ Finset.range n, (f i - f (i + 1)) = f 0 - f n
@Finset.sum_congr : ∀ {ι : Type u_1} {M : Type u_2} {s₁ s₂ : Finset ι} [inst : AddCommMonoid M] {f g : ι → M},
  s₁ = s₂ → (∀ x ∈ s₂, f x = g x) → s₁.sum f = s₂.sum g
@Finset.sum_add_distrib : ∀ {ι : Type u_1} {M : Type u_2} {s : Finset ι} [inst : AddCommMonoid M] {f g : ι → M},
  ∑ x ∈ s, (f x + g x) = ∑ x ∈ s, f x + ∑ x ∈ s, g x
@Finset.sum_sub_distrib : ∀ {ι : Type u_1} {G : Type u_2} {s : Finset ι} [inst : SubtractionCommMonoid G] (f g : ι → G),
  ∑ x ∈ s, (f x - g x) = ∑ x ∈ s, f x - ∑ x ∈ s, g x
@Finset.mul_sum : ∀ {ι : Type u_1} {R : Type u_2} [inst : NonUnitalNonAssocSemiring R] (s : Finset ι) (f : ι → R)
  (a : R), a * ∑ i ∈ s, f i = ∑ i ∈ s, a * f i
@Finset.sum_mul : ∀ {ι : Type u_1} {R : Type u_2} [inst : NonUnitalNonAssocSemiring R] (s : Finset ι) (f : ι → R)
  (a : R), (∑ i ∈ s, f i) * a = ∑ i ∈ s, f i * a
@Finset.sum_mul_sum : ∀ {ι : Type u_1} {κ : Type u_2} {R : Type u_3} [inst : NonUnitalNonAssocSemiring R] (s : Finset ι)
  (t : Finset κ) (f : ι → R) (g : κ → R), (∑ i ∈ s, f i) * ∑ j ∈ t, g j = ∑ i ∈ s, ∑ j ∈ t, f i * g j
@Finset.sum_comm : ∀ {α : Type u_1} {β : Type u_2} {γ : Type u_3} [inst : AddCommMonoid β] {s : Finset γ} {t : Finset α}
  {f : γ → α → β}, ∑ x ∈ s, ∑ y ∈ t, f x y = ∑ y ∈ t, ∑ x ∈ s, f x y
@pow_dvd_pow_of_dvd : ∀ {α : Type u_1} [inst : CommMonoid α] {a b : α}, a ∣ b → ∀ (n : ℕ), a ^ n ∣ b ^ n
@dvd_pow_self : ∀ {α : Type u_1} [inst : Monoid α] (a : α) {n : ℕ}, n ≠ 0 → a ∣ a ^ n
@pow_add : ∀ {M : Type u_1} [inst : Monoid M] (a : M) (m n : ℕ), a ^ (m + n) = a ^ m * a ^ n
@pow_mul : ∀ {M : Type u_1} [inst : Monoid M] (a : M) (m n : ℕ), a ^ (m * n) = (a ^ m) ^ n
@pow_succ : ∀ {M : Type u_1} [inst : Monoid M] (a : M) (n : ℕ), a ^ (n + 1) = a ^ n * a
@pow_succ' : ∀ {M : Type u_1} [inst : Monoid M] (a : M) (n : ℕ), a ^ (n + 1) = a * a ^ n
