@Polynomial.eval_finsetSum : ∀ {R : Type u_1} {ι : Type u_2} [inst : Semiring R] (s : Finset ι) (g : ι → Polynomial R)
  (x : R), Polynomial.eval x (∑ i ∈ s, g i) = ∑ i ∈ s, Polynomial.eval x (g i)
@Polynomial.X_add_C_ne_zero : ∀ {R : Type u_1} [Nontrivial R] [inst : Semiring R] (r : R),
  Polynomial.X + Polynomial.C r ≠ 0
@geom_sum_mul : ∀ {R : Type u_1} [inst : Ring R] (x : R) (n : ℕ), (∑ i ∈ Finset.range n, x ^ i) * (x - 1) = x ^ n - 1
