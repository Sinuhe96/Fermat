@Finset.sum_sigma' : ∀ {α : Type u_1} {β : Type u_2} [inst : AddCommMonoid β] {σ : α → Type u_3} (s : Finset α)
  (t : (a : α) → Finset (σ a)) (f : (a : α) → σ a → β), ∑ a ∈ s, ∑ s ∈ t a, f a s = ∑ x ∈ s.sigma t, f x.fst x.snd
@Finset.sum_finset_product : ∀ {α : Type u_1} {β : Type u_2} {γ : Type u_3} [inst : AddCommMonoid β]
  (r : Finset (γ × α)) (s : Finset γ) (t : γ → Finset α),
  (∀ (p : γ × α), p ∈ r ↔ p.1 ∈ s ∧ p.2 ∈ t p.1) → ∀ {f : γ × α → β}, ∑ p ∈ r, f p = ∑ c ∈ s, ∑ a ∈ t c, f (c, a)
